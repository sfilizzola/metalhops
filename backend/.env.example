PORT=8080
# Supabase session pooler URL (port 5432 on the pooler host).
# This user must own the product tables. Do not use authenticator or service_role.
DATABASE_URL=
# Project URL. The API derives the issuer, JWKS, and Admin URL from it.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Server only. Never put this in a client app.
SUPABASE_SERVICE_ROLE_KEY=
# Scalar UI at /docs. Unset or true enables it. Render sets false.
DOCS_UI_ENABLED=true
# Empty uses the TCP peer. Render sets the pinned Cloudflare ranges and 10.0.0.0/8.
TRUSTED_PROXIES=
# Comma-separated browser origins allowed to call this API cross-origin
# (scheme + host, no path). Empty disables CORS; native app clients are
# unaffected either way since they never send an Origin header.
ALLOWED_ORIGINS=
# Required gap between one User's check-ins at one Venue. Unset also means 1h.
CHECKIN_SPACING=1h
