{
  "$description": "MetalHops design tokens, direction Backline. Source of truth: tokens.css is generated from this file by build-tokens.mjs. Lengths are unitless: px on web, dp in Compose, pt in SwiftUI.",
  "color": {
    "surface":              { "dark": "oklch(0.15 0.018 25)",  "light": "oklch(0.97 0.012 80)",  "compose": "surface",              "swiftui": "surface" },
    "surface-field":        { "dark": "oklch(0.12 0.015 25)",  "light": "oklch(0.995 0.004 80)", "compose": "surfaceContainerLowest", "swiftui": "surfaceField" },
    "surface-raised":       { "dark": "oklch(0.205 0.024 25)", "light": "oklch(0.995 0.004 80)", "compose": "surfaceContainer",     "swiftui": "surfaceRaised" },
    "surface-overlay":      { "dark": "oklch(0.25 0.026 28)",  "light": "oklch(1 0 0)",          "compose": "surfaceContainerHigh", "swiftui": "surfaceOverlay" },
    "on-surface":           { "dark": "oklch(0.94 0.02 75)",   "light": "oklch(0.22 0.03 30)",   "compose": "onSurface",            "swiftui": "onSurface" },
    "on-surface-muted":     { "dark": "oklch(0.77 0.03 70)",   "light": "oklch(0.45 0.03 40)",   "compose": "onSurfaceVariant",     "swiftui": "onSurfaceMuted" },
    "outline":              { "dark": "oklch(0.55 0.04 45)",   "light": "oklch(0.58 0.03 45)",   "compose": "outline",              "swiftui": "outline" },
    "outline-variant":      { "dark": "oklch(0.32 0.03 30)",   "light": "oklch(0.87 0.015 60)",  "compose": "outlineVariant",       "swiftui": "outlineVariant" },
    "primary":              { "dark": "oklch(0.8 0.15 68)",    "light": "oklch(0.53 0.13 55)",   "compose": "primary",              "swiftui": "primary" },
    "on-primary":           { "dark": "oklch(0.18 0.03 45)",   "light": "oklch(0.99 0.008 80)",  "compose": "onPrimary",            "swiftui": "onPrimary" },
    "primary-container":    { "dark": "oklch(0.3 0.06 60)",    "light": "oklch(0.92 0.06 78)",   "compose": "primaryContainer",     "swiftui": "primaryContainer" },
    "on-primary-container": { "dark": "oklch(0.88 0.1 78)",   "light": "oklch(0.36 0.08 50)",   "compose": "onPrimaryContainer",   "swiftui": "onPrimaryContainer" },
    "accent":               { "dark": "oklch(0.66 0.18 27)",   "light": "oklch(0.5 0.17 27)",    "compose": "tertiary",             "swiftui": "accent" },
    "on-accent":            { "dark": "oklch(0.16 0.02 25)",   "light": "oklch(0.99 0.008 80)",  "compose": "onTertiary",           "swiftui": "onAccent" },
    "success":              { "dark": "oklch(0.8 0.13 150)",   "light": "oklch(0.47 0.11 150)",  "compose": "success (custom)",     "swiftui": "success" },
    "on-success":           { "dark": "oklch(0.18 0.03 150)",  "light": "oklch(0.99 0.008 80)",  "compose": "onSuccess (custom)",   "swiftui": "onSuccess" },
    "success-container":    { "dark": "oklch(0.27 0.05 150)",  "light": "oklch(0.93 0.05 150)",  "compose": "successContainer (custom)", "swiftui": "successContainer" },
    "on-success-container": { "dark": "oklch(0.86 0.12 150)",  "light": "oklch(0.34 0.08 150)",  "compose": "onSuccessContainer (custom)", "swiftui": "onSuccessContainer" },
    "warning":              { "dark": "oklch(0.85 0.14 90)",   "light": "oklch(0.8 0.15 85)",    "compose": "warning (custom)",     "swiftui": "warning" },
    "on-warning":           { "dark": "oklch(0.2 0.03 80)",    "light": "oklch(0.2 0.03 80)",    "compose": "onWarning (custom)",   "swiftui": "onWarning" },
    "danger":               { "dark": "oklch(0.72 0.16 25)",   "light": "oklch(0.5 0.18 27)",    "compose": "error",                "swiftui": "danger" },
    "on-danger":            { "dark": "oklch(0.16 0.02 25)",   "light": "oklch(0.99 0.008 80)",  "compose": "onError",              "swiftui": "onDanger" },
    "focus":                { "dark": "oklch(0.84 0.075 230)",   "light": "oklch(0.5 0.12 250)",   "compose": "focus indicator (custom)", "swiftui": "focus" },
    "scrim":                { "dark": "oklch(0 0 0 / 0.6)",    "light": "oklch(0.2 0.03 30 / 0.4)", "compose": "scrim",             "swiftui": "scrim" }
  },
  "contrast": [
    ["on-surface", "surface", 4.5], ["on-surface", "surface-raised", 4.5], ["on-surface", "surface-field", 4.5], ["on-surface", "surface-overlay", 4.5],
    ["on-surface-muted", "surface", 4.5], ["on-surface-muted", "surface-raised", 4.5], ["on-surface-muted", "surface-field", 4.5],
    ["primary", "surface", 4.5], ["primary", "surface-raised", 4.5],
    ["on-primary", "primary", 4.5], ["on-primary-container", "primary-container", 4.5],
    ["on-accent", "accent", 4.5],
    ["on-success", "success", 4.5], ["on-success-container", "success-container", 4.5],
    ["on-warning", "warning", 4.5],
    ["on-danger", "danger", 4.5], ["danger", "surface", 4.5], ["danger", "surface-raised", 4.5], ["danger", "surface-field", 4.5],
    ["outline", "surface", 3], ["outline", "surface-raised", 3], ["outline", "surface-field", 3],
    ["primary", "primary-container", 3], ["focus", "surface", 3], ["focus", "surface-raised", 3]
  ],
  "font": {
    "display": { "family": "Grenze Gotisch", "fallback": "Georgia, serif", "licence": "SIL OFL 1.1" },
    "body":    { "family": "IBM Plex Sans",  "fallback": "system-ui, sans-serif", "licence": "SIL OFL 1.1" }
  },
  "type": {
    "display": { "font": "display", "size": 48, "lineHeight": 52, "weight": 700, "tracking": 0 },
    "title":   { "font": "display", "size": 32, "lineHeight": 36, "weight": 700, "tracking": 0 },
    "heading": { "font": "body",    "size": 20, "lineHeight": 28, "weight": 600, "tracking": 0 },
    "body":    { "font": "body",    "size": 17, "lineHeight": 26, "weight": 400, "tracking": 0 },
    "label":   { "font": "body",    "size": 14, "lineHeight": 20, "weight": 600, "tracking": 0.06 },
    "caption": { "font": "body",    "size": 13, "lineHeight": 18, "weight": 400, "tracking": 0.01 }
  },
  "space":  { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "none": 0, "sm": 4, "md": 8, "lg": 12, "full": 999 },
  "border": { "hairline": 1, "strong": 2, "focus": 3 },
  "size":   { "tap-min": 48, "icon-sm": 16, "icon-md": 20, "icon-lg": 24, "avatar-compact": 32, "avatar-full": 56 },
  "elevation": {
    "0": { "dark": "none", "light": "none", "surface": "surface" },
    "1": { "dark": "0 0 0 1px oklch(0.32 0.03 30), 0 2px 4px oklch(0 0 0 / 0.4)", "light": "0 0 0 1px oklch(0.87 0.015 60), 0 1px 3px oklch(0.3 0.03 30 / 0.1)", "surface": "surface-raised" },
    "2": { "dark": "0 0 0 1px oklch(0.36 0.03 30), 0 16px 36px -10px oklch(0 0 0 / 0.7)", "light": "0 0 0 1px oklch(0.87 0.015 60), 0 12px 28px -10px oklch(0.3 0.03 30 / 0.22)", "surface": "surface-overlay" }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": {
      "standard":   [0.2, 0, 0, 1],
      "decelerate": [0.05, 0.7, 0.1, 1],
      "accelerate": [0.3, 0, 1, 1]
    }
  }
}
