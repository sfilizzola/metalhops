# Supabase project URL (public; ships in the bundle).
VITE_SUPABASE_URL=
# Supabase publishable key only; never a service-role/secret key (VITE_* is public in the bundle).
VITE_SUPABASE_PUBLISHABLE_KEY=
# MetalHops backend base URL. Required for builds and must be https there; only `npm run dev`
# falls back to http://localhost:8080 when it is empty.
VITE_API_BASE_URL=http://localhost:8080
